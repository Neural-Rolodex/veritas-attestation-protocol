# --- Server ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGIN=*

# --- SQLite (node:sqlite, file based) ---
DATABASE_PATH=./data/impact.db

# --- Chain / EAS ---
# Local Hardhat node (dev default). Point RPC_URL at Sepolia etc. in production.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Optional explicit addresses. If unset, they are read from DEPLOYMENTS_FILE.
REGISTRY_ADDRESS=
EAS_ADDRESS=
DEPLOYMENTS_FILE=../contracts/deployments/local.json
# Block explorer base URL used to build attestation/tx links in the UI.
EXPLORER_URL=

# --- Oracle ---
# EOA private key of the oracle. The registry's `oracle` role must match its address.
# Dev default = Hardhat account #1 (0x70997970C51812dc3A010C7d01b50e0d17dc79C8).
# In production rotate this and never commit real keys.
ORACLE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- Ingestion pipeline ---
INGEST_ON_START=true
# How often the pipeline refreshes metrics + attestations (ms).
INGEST_INTERVAL_MS=21600000
# Optional GitHub token (unauthenticated API is rate-limited to 60 req/hr).
GITHUB_TOKEN=

# --- Admin API ---
# Required for POST/PATCH/DELETE endpoints (X-API-Key header).
ADMIN_API_KEY=dev-admin-key
